# Knovaryn — environment configuration example
# =====================================================================
# Copy this file to `.env` (or set the variables in your shell / CI) and
# fill in your own values. **Never commit a real `.env`** — it is git-ignored.
#
# This file ships with PLACEHOLDERS ONLY. Replace every  <...>  token with a
# real value. Knovaryn reads credentials exclusively from the environment at
# runtime; they are redacted at display boundaries and never written to logs,
# the cost ledger, or audit records.
#
# Everything here is OPTIONAL. The default configuration is fully offline and
# needs no keys at all (deterministic fake provider). Only set the variables
# below when you want to opt in to live models / publication / auth.
# =====================================================================

# ---------------------------------------------------------------------
# Live model provider (optional)
# ---------------------------------------------------------------------
# When unset, Knovaryn uses a deterministic fake provider — no key, no network.
# Set these to enable live generation via LiteLLM / an OpenAI-compatible API.

# DeepSeek / OpenAI-compatible API key (used by the LiteLLM provider).
# Must be a real secret value — never commit it.
KNOVARYN_DEEPSEEK_API_KEY=<your-api-key>

# Optional base URL for a compatible endpoint.
# Defaults to https://api.deepseek.com if unset.
KNOVARYN_DEEPSEEK_BASE_URL=<https://api.example.com/v1>

# Optional model overrides (used by the model gateway). Defaults are
# profile-dependent; leave unset to use the profile defaults.
#KNOVARYN_GENERATOR_MODEL=<model-name>
#KNOVARYN_CRITIC_MODEL=<model-name>
#KNOVARYN_VERIFIER_MODEL=<model-name>
#KNOVARYN_EMBEDDING_MODEL=<model-name>

# ---------------------------------------------------------------------
# REST API authentication (optional)
# ---------------------------------------------------------------------
# When set, the local REST server / web console require a Bearer token of this
# value. Empty (default) = local, unauthenticated loopback mode.
#KNOVARYN_SERVER_API_TOKEN=<a-long-random-token>

# ---------------------------------------------------------------------
# Hugging Face publication (optional — outward-facing action)
# ---------------------------------------------------------------------
# Only needed to publish a release bundle to the Hugging Face Hub. Knovaryn
# never publishes autonomously: it requires an explicit authorized flag AND a
# token. Dry-run is the default.
#HF_TOKEN=<your-hf-token>

# ---------------------------------------------------------------------
# Runtime / telemetry tuning (optional)
# ---------------------------------------------------------------------
# Verbosity of Knovaryn's own logs: DEBUG | INFO | WARNING | ERROR | CRITICAL
#KNOVARYN_LOG_LEVEL=INFO

# Set to 1/true/yes to allow document *content* in logs. Strongly discouraged
# for anything sensitive — content is off by default and this is a foot-gun.
#KNOVARYN_LOG_CONTENT=false

# Set (any truthy value) to force CPU-only operation (ignore GPU detection).
#KNOVARYN_FORCE_CPU=false
