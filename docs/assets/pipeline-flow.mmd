%% Knovaryn — end-to-end pipeline flow (contract §12.1)
%% Two rows of four stages: readable at README width and in a docs column.
%% Facts preserved: provenance precision · plan/budget/profile/targets ·
%% semantic + preference validation · information gain · review routing ·
%% release/export integrity. Count-free by policy.
%% Brand palette (docs/design-system/tokens.css): Trace #0e7c6b,
%% Ink #1c2b33, Signal amber #b45309, error #b3261e, info slate #404d55.
%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#909ea6", "primaryTextColor": "#1c2b33", "lineColor": "#4c5b61", "secondaryColor": "#e0f0ec", "tertiaryColor": "#f1efe8", "clusterBkg": "#f7f6f2", "clusterBorder": "#d3dadd", "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "fontSize": "15px"}, "flowchart": {"nodeSpacing": 30, "rankSpacing": 40}}}%%
flowchart TB
    subgraph ROW1["Prepare — documents to plan"]
        direction LR
        I["<b>1 · Intake</b><br/>permitted documents, untrusted<br/>SHA-256 · size · license · privacy"]
        P["<b>2 · Parse</b><br/>Docling canonical JSON (PDF/office)<br/>built-in Markdown/text"]
        C["<b>3 · Split &amp; chunk</b><br/>source-group splits · structure-aware<br/><code>source_span_ids</code> + location precision"]
        PL["<b>4 · Plan</b> — dry run, no model calls<br/>topologies · task/difficulty mix · target<br/>cost estimate vs budget cap"]
        I --> P --> C --> PL
    end

    subgraph ROW2["Produce — plan to verified dataset"]
        direction LR
        G["<b>5 · Generate</b> — durable stage<br/>ModelGateway: fake offline or real endpoints<br/>provider-call cache: no double spend"]
        V["<b>6 · Validate</b><br/>schema · grounding · completeness<br/>semantic consistency · preference signal<br/>information gain · dedupe · privacy/license"]
        RV["<b>7 · Review</b><br/>human approve/reject<br/>immutable revisions with evidence"]
        E["<b>8 · Version &amp; export</b><br/>immutable version + reports + checksums<br/>exporters re-resolve citations<br/>publish: dry-run by default"]
        G --> V
        V -- "fail → quarantine<br/>(reason codes, never exported)" --> RV
        V -- "pass" --> RV
        RV --> E
    end

    ROW1 --> ROW2

    classDef stage fill:#e0f0ec,stroke:#0e7c6b,color:#1c2b33
    classDef plain fill:#ffffff,stroke:#909ea6,color:#1c2b33
    classDef gate fill:#fdeedd,stroke:#b45309,color:#1c2b33
    class I,P,C,G,E stage
    class V gate
    class PL,RV plain
