%% Knovaryn — System Architecture (contract §12.2)
%% Strict vertical layers, wired subgraph-to-subgraph so each layer keeps
%% its horizontal layout: users & agents → interfaces → application core
%% → durable pipeline → infrastructure → deployment profiles.
%% Count-free by policy: surfaces say what they are, never how many —
%% the live catalogue/reference pages carry the real numbers.
%% Brand palette per docs/design-system/tokens.css (Trace/Ink/amber/slate).
%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#909ea6", "primaryTextColor": "#1c2b33", "lineColor": "#4c5b61", "secondaryColor": "#e0f0ec", "tertiaryColor": "#f1efe8", "clusterBkg": "#f7f6f2", "clusterBorder": "#d3dadd", "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "fontSize": "15px"}, "flowchart": {"nodeSpacing": 30, "rankSpacing": 42}}}%%
flowchart TB
    subgraph USERS["Users and agents"]
        direction LR
        U1["You — terminal · editor agent · MCP client · browser"]
    end

    subgraph IFACE["Interfaces — one application core"]
        direction LR
        C["CLI<br/><code>knovaryn</code>"]
        M["MCP server<br/><code>knovaryn-mcp</code><br/>registered tool catalogue"]
        R["REST + web console<br/><code>knovaryn server</code><br/>auth scopes · tenancy · rate limits"]
        S["Python SDK<br/><code>Workspace</code>"]
        C ~~~ M ~~~ R ~~~ S
    end

    subgraph CORE["Application-services core (domain + application)"]
        direction LR
        WS["Workspace control plane"]
        SRV["Services: projects · sources · jobs · datasets"]
        POL["Domain policies · dated acceptance config"]
        WS ~~~ SRV ~~~ POL
    end

    subgraph ENGINE["Durable pipeline engine — checkpointed stages"]
        direction LR
        IN["Intake &amp; preflight"] --> PA["Parse"] --> SP["Split &amp; chunk"] --> PL["Plan (dry-run cost)"] --> GE["Generate (ModelGateway)"] --> VA["Validate &amp; gates"] --> VE["Version &amp; export"] --> PU["Publish (dry-run default)"]
    end

    subgraph INFRA["Infrastructure"]
        direction LR
        DB[("Metadata: SQLite / PostgreSQL")]
        ART[("Artifacts: content-addressed, local / S3")]
        MGW["Model gateway: fake offline · LiteLLM profiles"]
        DB ~~~ ART ~~~ MGW
    end

    subgraph DEPLOY["Deployment profiles — same core, config not fork"]
        direction LR
        D1["Local — single process<br/>SQLite + filesystem"]
        D2["Compose — api · worker(s) ·<br/>postgres · minio · proxy"]
        D3["Kubernetes — kustomize base<br/>migration Job · api + worker"]
        D1 ~~~ D2 ~~~ D3
    end

    USERS --> IFACE
    IFACE --> CORE
    CORE --> ENGINE
    ENGINE --> INFRA
    INFRA --> DEPLOY

    classDef iface fill:#e0f0ec,stroke:#0e7c6b,color:#1c2b33
    classDef core fill:#ffffff,stroke:#909ea6,color:#1c2b33
    classDef stage fill:#f1efe8,stroke:#404d55,color:#1c2b33
    classDef gate fill:#fdeedd,stroke:#b45309,color:#1c2b33
    classDef infra fill:#ffffff,stroke:#909ea6,color:#1c2b33
    classDef dep fill:#e8edf0,stroke:#404d55,color:#1c2b33
    class C,M,R,S iface
    class WS,SRV,POL core
    class IN,PA,SP,PL,GE,VE,PU stage
    class VA gate
    class DB,ART,MGW infra
    class D1,D2,D3 dep
