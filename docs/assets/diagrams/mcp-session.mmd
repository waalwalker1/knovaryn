%% review · Version & release. The full tool catalogue lives on the
%% generated MCP-tools reference page, never in one crowded image.
%% Count-free by policy: no hard-coded tool totals in diagrams.
%% Brand palette per docs/design-system/tokens.css (Trace/Ink/amber/slate).
%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#ffffff", "primaryBorderColor": "#909ea6", "primaryTextColor": "#1c2b33", "lineColor": "#4c5b61", "secondaryColor": "#e0f0ec", "tertiaryColor": "#f1efe8", "clusterBkg": "#f7f6f2", "clusterBorder": "#d3dadd", "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "fontSize": "15px"}, "flowchart": {"nodeSpacing": 30, "rankSpacing": 46}}}%%
flowchart LR
    subgraph PHASE1["Phase 1 · Setup"]
        direction TB
        A["knovaryn_create_project"] --> B["knovaryn_add_source"]
        B --> C["knovaryn_inspect_source<br/>knovaryn_license_report"]
    end

    subgraph PHASE2["Phase 2 · Estimate &amp; generate"]
        direction TB
        E["knovaryn_estimate_run<br/>(dry-run cost)"] --> F{"budget OK?"}
        F -- "yes" --> G["knovaryn_start_pipeline"]
        F -- "no / tune plan" --> E
        G --> H["knovaryn_get_job<br/>knovaryn_run_job"]
    end

    subgraph PHASE3["Phase 3 · Inspect &amp; review"]
        direction TB
        I["knovaryn_preview_examples<br/>knovaryn_lineage"] --> J["knovaryn_review_example<br/>(immutable revisions)"]
        J --> K["knovaryn_validate_dataset<br/>knovaryn_compare_runs"]
    end

    subgraph PHASE4["Phase 4 · Version &amp; release"]
        direction TB
        L["knovaryn_create_dataset_version"] --> M["knovaryn_export_dataset"]
        M --> N["knovaryn_publish_dataset<br/>(dry-run → confirm)"]
    end

    P["knovaryn_doctor<br/>health check — anytime"]

    PHASE1 --> PHASE2 --> PHASE3 --> PHASE4

