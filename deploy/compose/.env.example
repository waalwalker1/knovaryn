# Knovaryn production Compose — environment (copy to `.env` and fill in).
#   cp deploy/compose/.env.example deploy/compose/.env
#
# NEVER commit a real .env. These values drive the shared Postgres + MinIO
# topology. Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me-postgres-password

# --- MinIO / S3-compatible object store ---
MINIO_ROOT_USER=knovaryn
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- API bearer token (empty = local mode; set a token to enforce auth) ---
KNOVARYN_API_TOKEN=
